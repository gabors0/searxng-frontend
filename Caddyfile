{
	admin off
	auto_https off
	persist_config off
}

# Cloudflare terminates TLS, and access logging stays off so queries are not recorded.
:80 {
	encode gzip
	root * /srv

	# no-referrer keeps queries out of requests to result sites and thumbnail hosts.
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src https: http: data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}

	handle /healthz {
		respond 200
	}

	handle_path /api/* {
		header {
			Cache-Control no-store
			defer
		}
		reverse_proxy core:{$SEARXNG_PORT}
	}

	# The key is added here, so it never reaches the browser.
	handle /ai/summary {
		header {
			Cache-Control no-store
			defer
		}

		@notPost not method POST
		respond @notPost 405

		# Stops other sites spending credit through a signed-in browser.
		@crossSite not header Sec-Fetch-Site same-origin
		respond @crossSite 403

		@noKey expression `{env.OPENROUTER_API_KEY} == ""`
		header @noKey Content-Type application/json
		respond @noKey `{"error":{"code":"not_configured"}}` 503

		# Follow-ups carry the conversation so far, including results from their searches.
		request_body {
			max_size 128KB
		}

		rewrite * /api/v1/chat/completions
		reverse_proxy https://openrouter.ai {
			# Removes every incoming header, which covers Cookie (the Access cookie contains an
			# email address), Cf-*, X-Forwarded-*, X-Real-IP, Origin, Referer and the browser's own.
			header_up -*
			header_up Host openrouter.ai
			header_up Authorization "Bearer {env.OPENROUTER_API_KEY}"
			header_up Content-Type application/json
			header_up Accept text/event-stream
			# Lets the stream arrive line by line, rather than compressed.
			header_up Accept-Encoding identity
			header_up User-Agent searxng-frontend
			header_down -Set-Cookie
			flush_interval -1
		}
	}

	# Fetches result images through this origin so Save and Copy can read them. See imgproxy/main.go.
	handle /img {
		@notGet not method GET
		respond @notGet 405

		# Only this app may use it, not other sites through a signed-in browser.
		@crossSite not header Sec-Fetch-Site same-origin
		respond @crossSite 403

		reverse_proxy 127.0.0.1:8085 {
			# Drops the Access cookie and the rest of the browser's headers.
			header_up -*
		}
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /opensearch.xml {
		header Content-Type application/opensearchdescription+xml
		file_server
	}

	# The app routes /engines itself, so it gets the same page as /.
	handle {
		header Cache-Control no-cache
		rewrite /engines /index.html
		file_server
	}
}
